# Copy to .env and fill in. Nested keys use __ (double underscore).
PHD_SEARCHER__LOG_LEVEL=INFO
PHD_SEARCHER__LLM__MODEL=azure/gpt-4o
# Da docker compose un LLM locale sull'host è http://host.docker.internal:<porta>, non localhost.
PHD_SEARCHER__LLM__API_BASE=
PHD_SEARCHER__LLM__API_KEY=
PHD_SEARCHER__EMBEDDING__MODEL=azure/text-embedding-3-large
PHD_SEARCHER__EMBEDDING__API_BASE=
PHD_SEARCHER__EMBEDDING__API_KEY=

# Database (SQLAlchemy async URL). schema_name defaults to "public".
PHD_SEARCHER__DATABASE__URL=postgresql+asyncpg://app:app@localhost:5433/app
PHD_SEARCHER__DATABASE__SCHEMA_NAME=public

# Qdrant
PHD_SEARCHER__QDRANT__URL=http://localhost:6333
PHD_SEARCHER__QDRANT__COLLECTION=positions

# Search-engine discovery (strato 3): ddg (default, senza chiave) | brave | none
PHD_SEARCHER__SEARCH__PROVIDER=ddg
PHD_SEARCHER__SEARCH__API_KEY=

# Telemetry (optional): JSON list of exporter backends. Empty = off.
# TELEMETRY__BACKENDS=[{"type":"console"}]
